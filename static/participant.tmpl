<html>
  <head>
    <link href="/css/base.css" rel="stylesheet" />
    <link href="/css/participant.css" rel="stylesheet" />
	{{template "head.tmpl"}}
  </head>
  <body>
    <div id="fdiv">
      <div id="gdiv">
	<h2 id="title">ILUGC Monthly Meet Registration Details</h2>
	<!--<div id="table-container"><table>
	{{ range $key, $value := .ParticipantMap }}
	<tr>
		<td><p>{{- $key -}}</p></td>
		<td><p>{{- $value -}}</p></td>
	</tr>
	{{ end }}
	</table></div> -->
	{{ range $key, $value := .ParticipantMap }}
		<label>{{- $key -}}</label>
		<input type="text" value="{{- $value -}}" readonly/>
	{{ end }}
	<a id="qrlink" href="{{- .QrCodeUrl -}}" target="_blank"><img id="qr" src="{{- .QrCodeUrl -}}" /></a>
	<a id="participantlink" href="{{- .ParticipantUrl -}}">Registration Details</a>
	<p id="info">Unregister if your plan changes before registration closing time</p>
	<button id="print" class="hide-on-print" type="button" value="Print" onclick="print()">Print</button>
	<div id="links"><a id="delete" class="hide-on-print" href="{{- .UnregisterUrl -}}">Unregister</a>
	<a id="home" class="hide-on-print" href="/">Home</a></div>
      </div>
    </div>
    {{template "sourcecode.tmpl"}}
  </body>
</html>
